<% layout("/layouts/boilerplate") %>

  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 1.5rem;
      opacity: 0.7;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter i {
      font-size: 1.2rem;
    }

    .filter p {
      font-size: 0.8rem;
    }

    .extra {
      display: none;
    }

    #toggleBtn {
      margin-left: auto;
      margin-top: 1rem;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      display: flex;
      align-items: center;
    }

    .tax-toggle {
      margin-left: 1rem;
      margin-top: 1rem;
    }

    .tax-info {
      display: none;
    }

    .tax-toggle {
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      display: flex;
      align-items: center;
    }

  </style>


  <div id="filters">

    <!-- Visible Filters -->

    <div class="filter">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Iconic Cities</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-mountain"></i>
      <p>Mountains</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-crown"></i>
      <p>Luxury</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-cow"></i>
      <p>Farms</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-tent"></i>
      <p>Camping</p>
    </div>

    <div class="filter">
      <i class="fa-solid fa-snowflake"></i>
      <p>Arctic</p>
    </div>


    <!-- Hidden Filters -->

    <div class="filter extra">
      <i class="fa-solid fa-landmark-dome"></i>
      <p>Domes</p>
    </div>

    <div class="filter extra">
      <i class="fa-solid fa-sailboat"></i>
      <p>Boat Houses</p>
    </div>

    <div class="filter extra">
      <i class="fa-solid fa-tower-observation"></i>
      <p>Skyline Views</p>
    </div>

    <div class="filter extra">
      <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beaches</p>
    </div>

    <div class="filter extra">
      <i class="fa-solid fa-fire"></i>
      <p>Campfire</p>
    </div>

    <div class="filter extra">
      <i class="fa-solid fa-warehouse"></i>
      <p>Barns</p>
    </div>


    <!-- Show More Button -->

    <button id="toggleBtn" class="btn btn-outline-dark">
      Show More
    </button>


    <!-- Tax Toggle -->

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
        <label class="form-check-label" for="flexSwitchCheckDefault">
          Display total after taxes
        </label>
      </div>
    </div>
  </div>

  <!-- Listings -->

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" style="height:20rem;" alt="Listing_image">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b>
              <br/ >
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
              <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
      <% } %>
  </div>

  <script>

    // Tax toggle

    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (info of taxInfo) {
        if(info.style.display != "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });

    // Show More Toggle

    const toggleBtn = document.getElementById("toggleBtn");
    const extraFilters = document.querySelectorAll(".extra");

    let expanded = false;

    toggleBtn.addEventListener("click", () => {
      extraFilters.forEach(filter => {
        filter.style.display = expanded ? "none" : "block";
      });

      toggleBtn.textContent = expanded ? "Show More" : "Show Less";
      expanded = !expanded;
    });

  </script>